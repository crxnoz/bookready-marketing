ErrorDocument 404 /404.html

RewriteEngine On

# ─── Canonical host: mybookready.com → bkrdy.com (permanent 301) ───
# The BKRDY rebrand (2026-06-20) makes bkrdy.com the canonical marketing
# domain. mybookready.com stays registered forever and 301s here so the
# legacy index + any backlinks transfer cleanly (GSC Change of Address filed
# separately). Host-conditional so it ONLY fires for the old host — bkrdy.com
# requests fall through untouched, so there's no redirect loop even while both
# domains share one document root via the Hostinger parked-domain alias.
RewriteCond %{HTTP_HOST} ^(www\.)?mybookready\.com$ [NC]
RewriteRule ^(.*)$ https://bkrdy.com/$1 [R=301,L]

# www.bkrdy.com -> bkrdy.com (2026-10-31). www used to serve the same pages
# with a 200, a duplicate host for search, and the template pages embed the
# live demo ({key}.bkrdy.me), whose frame-ancestors allows bkrdy.com only.
RewriteCond %{HTTP_HOST} ^www\.bkrdy\.com$ [NC]
RewriteRule ^(.*)$ https://bkrdy.com/$1 [R=301,L]

# Legacy URLs (pre-restructure) -> current equivalents. Preserves any link
# equity and clears the GSC "Not found (404)" reports. The /wp-admin and
# /wp-content 404s are bot probes and are correctly left as 404.
RewriteRule ^booking-system/calendar-sync/?$ /platform/booking/sync/ [R=301,L]
RewriteRule ^booking-system/client-dashboard/?$ /platform/tools/customers/ [R=301,L]
RewriteRule ^booking-system/?$ /platform/booking/online/ [R=301,L]
RewriteRule ^template/?$ /templates/ [R=301,L]
RewriteRule ^features/personalized-branding/?$ /platform/website/sections/ [R=301,L]
RewriteRule ^features/easy-editing/?$ /platform/website/templates/ [R=301,L]

# Rebrand phase 3 (2026-10-31): /features/* was a second copy of the product
# tree, and several of its pages sold things BKRDY does not do (email and SMS
# campaigns, win-back automations). /platform/* is now the one product tree;
# each old page points at the page that covers what is real. Recurring
# appointments do not exist, so that page goes to the calendar.
RewriteRule ^features/?$ /platform/ [R=301,L]
RewriteRule ^features/client/(booking|reschedule)/?$ /platform/booking/online/ [R=301,L]
RewriteRule ^features/client/dashboard/?$ /platform/tools/customers/ [R=301,L]
RewriteRule ^features/client/loyalty/?$ /platform/tools/loyalty/ [R=301,L]
RewriteRule ^features/client/payments/?$ /platform/tools/payments/ [R=301,L]
RewriteRule ^features/client/reminders/?$ /platform/tools/notifications/ [R=301,L]
RewriteRule ^features/growth/analytics/?$ /platform/tools/analytics/ [R=301,L]
RewriteRule ^features/growth/email/?$ /platform/tools/marketing/ [R=301,L]
RewriteRule ^features/growth/reviews/?$ /platform/tools/reviews/ [R=301,L]
RewriteRule ^features/growth/sms/?$ /platform/tools/notifications/ [R=301,L]
RewriteRule ^features/growth/winback/?$ /platform/tools/customers/ [R=301,L]
RewriteRule ^features/manage/customers/?$ /platform/tools/customers/ [R=301,L]
RewriteRule ^features/manage/dashboard/?$ /platform/ [R=301,L]
RewriteRule ^features/manage/(hours|reschedule)/?$ /platform/booking/calendar/ [R=301,L]
RewriteRule ^features/manage/staff/?$ /platform/tools/team/ [R=301,L]
RewriteRule ^features/.+$ /platform/ [R=301,L]
RewriteRule ^platform/booking/recurring/?$ /platform/booking/calendar/ [R=301,L]

# /customers/ removed (page held fabricated testimonials before any real customers existed).
# Redirect to /templates/ — closest intent match for a visitor who clicked an old link.
RewriteRule ^customers/?$ /templates/ [R=301,L]

# Force trailing slash on directory URLs (consolidates link equity to one canonical form)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# ─── Compression (gzip) ───
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript text/javascript application/json image/svg+xml \
    application/xml application/rss+xml
</IfModule>

# ─── Cache static assets ───
# Images and fonts are unique by name and safe to cache for a year.
# CSS/JS are NOT cache-busted (git auto-pull deploy), so keep them short so
# returning visitors get updates. HTML revalidates hourly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType image/x-icon      "access plus 1 year"
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType text/css          "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ─── Block internal docs + dev scaffolding from the public web root ───
# These ship in the repo for maintainers but must not be world-readable
# (they were: ROADMAP.md etc. returned 200). Non-destructive: files stay
# in the repo, just 403 over HTTP. See docs/marketing-freemium-rebrand-sweep.md.
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
<FilesMatch "^(_stock-compare|personas-stock)\.html$">
  Require all denied
</FilesMatch>

# The whole /content/ directory is publishing pipeline (queue.json, sync and
# publish scripts) — repo-internal, never a public page. The FilesMatch rules
# above miss .json/.mjs, so deny the directory outright. robots.txt already
# disallows crawling it; this closes direct reads too.
RedirectMatch 403 ^/content/
RedirectMatch 403 ^/\.scratch/
