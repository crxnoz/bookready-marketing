# DataForSEO API credentials for content/keyword-research.mjs.
# Copy this file to .env (which is gitignored) and fill in your values.
#
# Find both at https://app.dataforseo.com/api-access
#   DATAFORSEO_LOGIN    = your account email
#   DATAFORSEO_PASSWORD = the API password shown on that page (NOT your login password)

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OpenAI API key for content/generate-images.mjs (blog hero images).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Resend API key + recipient for content/notify-email.mjs (daily blog email).
# Get a free key at https://resend.com/api-keys. NOTIFY_EMAIL is where the
# digest is sent. NOTIFY_FROM is optional: it defaults to onboarding@resend.dev,
# which can send to your own address without verifying a domain first.
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM must use a domain verified in Resend (mybookready.com is verified).
NOTIFY_FROM=BookReady <hello@mybookready.com>
