# DataForSEO API credentials for content/keyword-research.mjs.
# Copy this file to .env (which is gitignored) and fill in your values.
#
# Find both at https://app.dataforseo.com/api-access
#   DATAFORSEO_LOGIN    = your account email
#   DATAFORSEO_PASSWORD = the API password shown on that page (NOT your login password)

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OpenAI API key for content/generate-images.mjs (blog hero images).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Resend API key + recipient for content/notify-email.mjs (daily blog email).
# Get a free key at https://resend.com/api-keys. NOTIFY_EMAIL is where the
# digest is sent. NOTIFY_FROM is optional: it defaults to onboarding@resend.dev,
# which can send to your own address without verifying a domain first.
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM must use a domain verified in Resend (mybookready.com is verified).
NOTIFY_FROM=BookReady <newsletter@mybookready.com>

# Pexels API key for content/stock-images.mjs (real stock blog heroes, an
# alternative to the AI generator). Free key at https://www.pexels.com/api/.
# Commercial use is allowed with no attribution required.
PEXELS_API_KEY=

# Google Search Console API for content/gsc-check.mjs (indexing-health gate that
# makes the publisher cadence data-driven). One-time setup: create a Google Cloud
# service account + JSON key, enable the Search Console API, then add the service
# account client_email as a user on the mybookready.com property in Search Console.
# GSC_SA_KEY_FILE points at the gitignored JSON key; GSC_SITE_URL is the property
# (a URL-prefix property like below, or sc-domain:mybookready.com for a domain one).
GSC_SA_KEY_FILE=
GSC_SITE_URL=https://mybookready.com/
